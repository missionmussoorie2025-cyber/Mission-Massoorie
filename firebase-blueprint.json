{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User personal profile details and preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50 },
        "aspirantId": { "type": "string", "maxLength": 50 },
        "optionalSubject": { "type": "string", "maxLength": 100 },
        "targetCadre": { "type": "string", "maxLength": 100 },
        "motto": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 150 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId"]
    },
    "UserProgress": {
      "title": "UserProgress",
      "description": "User study telemetry, completion records, revision status, and notes",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "x": { "type": "object", "description": "Done status flags" },
        "d": { "type": "object", "description": "Completion dates" },
        "r": { "type": "object", "description": "Revision status arrays" },
        "starred": { "type": "object", "description": "Starred topics" },
        "notes": { "type": "object", "description": "Personal topic notes" },
        "topicMinutes": { "type": "object", "description": "Minutes logged per topic" },
        "mockScores": { "type": "object", "description": "Mock test scores" },
        "studySessions": { "type": "array", "description": "Study session logs" },
        "targetsConfig": { "type": "object", "description": "Custom target configuration" },
        "dailyTargets": { "type": "object", "description": "Locked daily targets batch" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account profiles"
    },
    "/users/{userId}/data/progress": {
      "schema": "UserProgress",
      "description": "User live preparation progress document"
    }
  }
}
